[Version]
Signature="$WINDOWS NT$"
Class=HIDClass
ClassGuid={745a17a0-74d3-11d0-b6fe-00a0c90f57da}
Provider="oltex"
CatalogFile=tablet-driver.cat
DriverVer=
PnpLockdown=1
[DestinationDirs]
DefaultDestDir = 12
[SourceDisksNames]
1 = "tablet-driver Install Disk",,,""
[SourceDisksFiles]
tablet-driver.sys  = 1


[Manufacturer]
"oltex"=Standard,NT$ARCH$
[Standard.NT$ARCH$]
"tablet-driver"=tablet-driver, Root\tablet-driver

[tablet-driver.NT]
CopyFiles=@tablet-driver.sys
[tablet-driver.NT.HW]
AddReg = AddReg 
[AddReg]
HKR,,"UpperFilters",0x00010000,"mshidkmdf"
[tablet-driver.NT.Services]
AddService = tablet-service,0x00000002,tablet-service_inst

[tablet-service_inst]
DisplayName = "tablet-service"
ServiceType = 1
StartType = 3
ErrorControl = 1
ServiceBinary = %12%\tablet-driver.sys